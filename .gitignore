# macOS
.DS_Store
**/.DS_Store
.dropboxignore

# Flutter / Android (dentro de app/)
app/build/
app/.dart_tool/
app/android/.gradle/
app/android/local.properties
app/android/build/
app/android/key.properties
app/ios/Pods/
app/ios/.symlinks/
app/.flutter-plugins-dependencies
app/.metadata
app/devtools_options.yaml

# Sensíveis
app/google-credentials.json
*.jks
*.keystore

# Python
__pycache__/
*.pyc
*.pyo

# Artefatos de build. Um AAB deste app passa de 100 MB, que é o teto do
# GitHub por arquivo, então um `git add -A` distraído quebraria o push.
# Os releases ficam em gestao-de-apps/aab-releases/ só localmente.
*.aab
*.apk
gestao-de-apps/aab-releases/
